/**app.wxss**/

/* 全局字体：微软雅黑（不含该字体的设备依次回退到苹方/系统默认） */
page,
button,
input,
textarea {
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
}

/* 所有交互按钮：文字水平 + 垂直居中 */
button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* 通用空状态（emoji 图标 + 标题 + 说明） */
.empty-state {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-state .empty-icon {
  font-size: 88rpx;
  line-height: 1;
}

.empty-state .empty-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.empty-state .empty-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}

.empty-state.small {
  margin-top: 40rpx;
}

.empty-state.small .empty-icon {
  font-size: 64rpx;
}
