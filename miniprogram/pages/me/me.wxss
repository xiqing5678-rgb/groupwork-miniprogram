/**pages/me/me.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 资料卡 */
.profile-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.avatar-wrapper {
  padding: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  line-height: 1;
  flex: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.edit-btn {
  flex: none;
  font-size: 24rpx;
  color: #2563eb;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-top: 24rpx;
}

.edit-card {
  padding: 32rpx;
}

.inner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.input {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
}

.btn-row {
  display: flex;
  margin-top: 16rpx;
}

.mini-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f2937;
  margin-right: 20rpx;
}

.mini-btn:last-child {
  margin-right: 0;
}

.mini-btn.primary {
  background: #2563eb;
  color: #ffffff;
  border: none;
  font-weight: 600;
}

.mini-btn[disabled] {
  opacity: 0.6;
  color: #ffffff;
}

/* 列表栏目 */
.list-card .cell {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.list-card .cell:last-child {
  border-bottom: none;
}

.cell-label {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}

.cell-value {
  font-size: 26rpx;
  color: #9ca3af;
}

.cell-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  margin-left: 12rpx;
}

/* 退出登录 */
.logout-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 48rpx;
  background: #ffffff;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer-tip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
