/**pages/task-detail/task-detail.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.center {
  margin-top: 160rpx;
  text-align: center;
}

.hint-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.retry-btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2563eb;
  border-radius: 36rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.status-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  margin-left: 16rpx;
  flex: none;
}

.status-tag.unassigned { color: #6b7280; background: #f3f4f6; }
.status-tag.assigned { color: #2563eb; background: #eff4ff; }
.status-tag.completed { color: #10b981; background: #e7f8f1; }
.status-tag.overdue { color: #ef4444; background: #fee2e2; }

.task-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.meta-grid {
  margin-top: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.meta-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.meta-item:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 26rpx;
  color: #6b7280;
}

.meta-value {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.claim-window {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  background: #f0f9ff;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.notice {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b45309;
  background: #fff7ed;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.notice.warn {
  color: #ef4444;
  background: #fee2e2;
}

.inner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.action-btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.action-btn.primary {
  background: #2563eb;
  color: #ffffff;
  border: none;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
}

.submit-type-row {
  display: flex;
  margin-bottom: 20rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 14rpx 0;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.type-btn.active {
  background: #eff4ff;
  color: #2563eb;
  font-weight: 600;
}

.file-btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 20rpx;
  background: #f8fafc;
  border: 1rpx dashed #d1d5db;
  color: #6b7280;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.input {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.submit-btn {
  display: block;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
}

.submit-btn[disabled] {
  opacity: 0.6;
  color: #ffffff;
}

.submission-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.submission-item:last-child {
  border-bottom: none;
}

.submission-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submission-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.on-time-tag {
  font-size: 22rpx;
  color: #10b981;
  background: #e7f8f1;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}

.on-time-tag.late {
  color: #ef4444;
  background: #fee2e2;
}

.submission-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.link-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2563eb;
  word-break: break-all;
}

.file-link {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2563eb;
}
