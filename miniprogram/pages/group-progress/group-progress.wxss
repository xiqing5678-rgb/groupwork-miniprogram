/**pages/group-progress/group-progress.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.center {
  margin-top: 160rpx;
  text-align: center;
}

.hint-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.retry-btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2563eb;
  border-radius: 36rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.group-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.progress-bar-wrap {
  margin-top: 32rpx;
  height: 16rpx;
  background: #eef0f3;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
  border-radius: 8rpx;
}

.progress-rate {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.overall-row {
  display: flex;
  margin-top: 32rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.overall-item {
  flex: 1;
  text-align: center;
}

.overall-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.overall-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.notice {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b45309;
  background: #fff7ed;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.notice.warn {
  color: #ef4444;
  background: #fee2e2;
}

.empty-hint {
  margin-top: 32rpx;
  padding: 40rpx 0;
  text-align: center;
}

.section-title {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  border-left: 8rpx solid #2563eb;
  padding-left: 16rpx;
}

.member-list {
  padding: 0 32rpx;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.member-row:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.member-info {
  flex: 1;
  margin-left: 20rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
}

.member-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.role-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}

.role-tag.leader {
  color: #2563eb;
  background: #eff4ff;
}

.member-stats {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
