<!--pages/task-create/task-create.wxml-->
<navigation-bar title="创建任务" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="page">
  <view class="card">
    <view class="mode-row">
      <view class="mode-btn {{assignMode === 'claim' ? 'active' : ''}}" data-mode="claim" bindtap="onSelectMode">成员认领</view>
      <view class="mode-btn {{assignMode === 'assign' ? 'active' : ''}}" data-mode="assign" bindtap="onSelectMode">组长分配</view>
    </view>

    <form bindsubmit="onSubmit">
      <view class="field">
        <text class="label">任务名称</text>
        <input class="input" name="name" placeholder="例如：完成需求分析文档" />
      </view>
      <view class="field">
        <text class="label">任务描述（可选）</text>
        <input class="input" name="description" placeholder="一句话说明任务内容" />
      </view>
      <view class="field">
        <text class="label">贡献率（1-100）</text>
        <input class="input" name="contribution" type="number" placeholder="例如：20" />
      </view>

      <block wx:if="{{assignMode === 'claim'}}">
        <view class="field">
          <text class="label">认领开始时间</text>
          <view class="picker-row">
            <picker mode="date" value="{{claimStartDate}}" data-field="claimStartDate" bindchange="onDateChange">
              <view class="picker-value">{{claimStartDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{claimStartTime}}" data-field="claimStartTime" bindchange="onTimeChange">
              <view class="picker-value">{{claimStartTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <text class="label">认领结束时间</text>
          <view class="picker-row">
            <picker mode="date" value="{{claimEndDate}}" data-field="claimEndDate" bindchange="onDateChange">
              <view class="picker-value">{{claimEndDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{claimEndTime}}" data-field="claimEndTime" bindchange="onTimeChange">
              <view class="picker-value">{{claimEndTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
      </block>

      <view class="field">
        <text class="label">截止时间</text>
        <view class="picker-row">
          <picker mode="date" value="{{deadlineDate}}" data-field="deadlineDate" bindchange="onDateChange">
            <view class="picker-value">{{deadlineDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{deadlineTime}}" data-field="deadlineTime" bindchange="onTimeChange">
            <view class="picker-value">{{deadlineTime || '选择时间'}}</view>
          </picker>
        </view>
      </view>

      <block wx:if="{{assignMode === 'assign'}}">
        <view class="field">
          <text class="label">任务负责人</text>
          <picker mode="selector" range="{{memberNames}}" value="{{assigneeIndex}}" bindchange="onAssigneeChange">
            <view class="picker-value">{{assigneeIndex >= 0 ? memberNames[assigneeIndex] : '选择负责人'}}</view>
          </picker>
        </view>
      </block>

      <button class="submit-btn" form-type="submit" disabled="{{submitting}}">
        {{submitting ? '创建中...' : '创建任务'}}
      </button>
    </form>
  </view>
</view>
</scroll-view>