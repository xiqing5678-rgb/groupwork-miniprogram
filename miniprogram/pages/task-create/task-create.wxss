/**pages/task-create/task-create.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.mode-row {
  display: flex;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.mode-btn.active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.input {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
}

.picker-row {
  display: flex;
}

.picker-row picker {
  flex: 1;
  margin-right: 20rpx;
}

.picker-value {
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.submit-btn {
  display: block;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 48rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
}

.submit-btn[disabled] {
  opacity: 0.6;
  color: #ffffff;
}
