/**pages/group-detail/group-detail.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.center {
  margin-top: 160rpx;
  text-align: center;
}

.hint-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.header-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.group-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
}

.group-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.invite-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.invite-label {
  font-size: 26rpx;
  color: #6b7280;
}

.invite-code {
  margin-left: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #2563eb;
}

.copy-btn {
  margin-left: auto;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff4ff;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
}

.meeting-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #f0f9ff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.meeting-value {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #2563eb;
}

.notice {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b45309;
  background: #fff7ed;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.notice.warn {
  color: #ef4444;
  background: #fee2e2;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-actions {
  display: flex;
  align-items: center;
}

.link-btn {
  font-size: 26rpx;
  color: #6b7280;
  margin-left: 24rpx;
}

.link-btn.primary {
  color: #2563eb;
}

.member-list {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.member-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.role-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
}

.role-tag.leader {
  color: #2563eb;
  background: #eff4ff;
}

.pending-card {
  margin-top: 20rpx;
  background: #fff7ed;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.pending-text {
  font-size: 26rpx;
  color: #b45309;
}

.empty-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.task-list {
  margin-top: 20rpx;
}

.task-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.task-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  margin-left: 16rpx;
  flex: none;
}

.status-tag.unassigned { color: #6b7280; background: #f3f4f6; }
.status-tag.assigned { color: #2563eb; background: #eff4ff; }
.status-tag.completed { color: #10b981; background: #e7f8f1; }
.status-tag.overdue { color: #ef4444; background: #fee2e2; }

.task-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta-row {
  display: flex;
  margin-top: 16rpx;
}

.task-meta {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 24rpx;
}

.task-meta.hint {
  color: #f97316;
}

.task-meta.hint.danger {
  color: #ef4444;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.inner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.picker-row {
  display: flex;
}

.picker-row picker {
  flex: 1;
  margin-right: 20rpx;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.mini-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5e7eb;
  margin-right: 20rpx;
}

.mini-btn.primary {
  background: #2563eb;
  color: #ffffff;
  border: none;
  font-weight: 600;
}

.danger-btn {
  display: block;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 16rpx;
  background: #ffffff;
  color: #ef4444;
  border: 1rpx solid #fecaca;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.inline-error {
  margin-top: 48rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2563eb;
  border-radius: 36rpx;
}

/* 页内分段导航 */
.detail-tabs {
  display: flex;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-top: 24rpx;
}

.detail-tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 12rpx;
}

.detail-tab.active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 任务 Tab 顶部行 */
.task-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.task-count {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 状态分组标题 */
.group-head {
  display: flex;
  align-items: center;
  margin: 28rpx 2rpx 12rpx;
}

.group-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.group-dot.gray { background: #9ca3af; }
.group-dot.blue { background: #2563eb; }
.group-dot.red { background: #ef4444; }
.group-dot.green { background: #10b981; }

.group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.group-count {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

/* 进度 Tab 概览 */
.progress-bar-wrap {
  margin-top: 28rpx;
  height: 16rpx;
  background: #eef0f3;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
  border-radius: 8rpx;
}

.progress-rate {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.overview-row {
  display: flex;
  margin-top: 28rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.progress-link {
  margin-top: 24rpx;
  text-align: right;
}

/* 设置 Tab 只读提示 */
.readonly-card {
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.readonly-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 任务池 */
.pool-head {
  display: flex;
  align-items: baseline;
  margin: 8rpx 2rpx 12rpx;
}

.pool-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.pool-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 12rpx;
}

.pool-card {
  background: #ffffff;
  border: 1rpx solid #dbeafe;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pool-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.pool-card__name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pool-card__score {
  flex: none;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}

.pool-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.pool-card__meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pool-meta {
  font-size: 22rpx;
  color: #9ca3af;
}

.claim-btn {
  flex: none;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 36rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(37, 99, 235, 0.24);
}

.claim-btn:active {
  background: #1d4ed8;
}

.pool-empty {
  padding: 20rpx 0 4rpx;
}

.pool-empty-text {
  font-size: 24rpx;
  color: #9ca3af;
}
