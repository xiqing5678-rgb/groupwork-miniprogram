/**index.wxss **/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.center {
  margin-top: 160rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 未初始化：完善资料提示 */
.setup-empty {
  width: 100%;
  padding: 200rpx 48rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.setup-empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.setup-empty-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.6;
}

.setup-empty-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 48rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 首页：欢迎头 */
.home-head {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 24rpx;
  box-sizing: border-box;
}

.home-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.home-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.home-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.home-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.home-arrow {
  font-size: 40rpx;
  color: #d1d5db;
}

/* 首页：蓝色统计卡 */
.stats-card {
  width: 100%;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border-radius: 24rpx;
  padding: 28rpx 8rpx;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
  box-sizing: border-box;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stats-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 首页：操作按钮 */
.home-actions {
  width: 100%;
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5e7eb;
  font-weight: 500;
}

.action-btn.primary {
  background: #2563eb;
  color: #ffffff;
  border: none;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
}

/* 分区 */
.section-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-link {
  font-size: 24rpx;
  color: #2563eb;
}

/* 小组卡片 */
.group-list {
  width: 100%;
  margin-top: 20rpx;
}

.group-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.group-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-tags {
  display: flex;
  align-items: center;
  flex: none;
}

.role-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  margin-left: 12rpx;
}

.role-tag.leader {
  color: #2563eb;
  background: #eff4ff;
}

.role-tag.ended {
  color: #ef4444;
  background: #fee2e2;
}

.group-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-meta-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.group-meta {
  flex: 1;
  font-size: 24rpx;
  color: #9ca3af;
}

.group-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

/* 错误重试 */
.inline-error {
  margin-top: 48rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 24rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2563eb;
  border-radius: 36rpx;
}
